VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>

# Closed Beta (optional, set in Vercel → Settings → Environment Variables, then redeploy)
# VITE_BETA_CODE=CLASH-BETA        # access code testers type once; leave unset to open the game to everyone
# VITE_FEEDBACK_URL=https://forms.gle/xxxx   # "Report a bug" button on the title screen
# VITE_BUILD_LABEL=Closed Beta     # label shown next to the version
